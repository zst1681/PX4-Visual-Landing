<?xml version="1.0"?>
<launch>
    <arg name="x" default="-1.5"/>
    <arg name="y" default="-1.5"/>
    <arg name="z" default="0"/>
    <arg name="gui" default="false"/>
    <arg name="interactive" default="false"/>
    <arg name="verbose" default="true"/>
    <arg name="world" default="$(find mavlink_sitl_gazebo)/worlds/aruco_search_demo.world"/>
    <arg name="marker_config_path" default="$(find px4)/config/aruco_nested_board.yaml"/>
    <arg name="sub_image_topic" default="/camera/image_raw"/>
    <arg name="detector_type" default="aruco_multi_marker_det.py"/>
    <arg name="dictionary_id" default="11"/>
    <arg name="aruco_id" default="31"/>
    <arg name="aruco_length" default="1.0"/>
    <arg name="takeoff_altitude" default="1.0"/>
    <arg name="search_spacing" default="0.5"/>
    <arg name="search_radius" default="1.5"/>
    <arg name="auto_arm_offboard" default="true"/>
    <arg name="land_descent_rate" default="0.15"/>
    <arg name="landing_commit_altitude" default="0.45"/>
    <arg name="auto_land_settle_time" default="1.0"/>
    <arg name="marker_estimate_window" default="0.8"/>
    <arg name="marker_estimate_alpha" default="0.65"/>
    <arg name="track_pid_kp" default="0.72"/>
    <arg name="track_pid_ki" default="0.0"/>
    <arg name="track_pid_kd" default="0.18"/>
    <arg name="land_pid_kp" default="0.58"/>
    <arg name="land_pid_ki" default="0.02"/>
    <arg name="land_pid_kd" default="0.16"/>
    <arg name="land_z_pid_kp" default="1.05"/>
    <arg name="land_z_pid_ki" default="0.06"/>
    <arg name="land_z_pid_kd" default="0.18"/>
    <arg name="success_result_path" default="/tmp/px4_aruco_search_result.json"/>
    <arg name="controller_type" default="aruco_search_and_detect.py"/>

    <include file="$(find px4)/launch/mavros_posix_sitl_aruco_project.launch">
        <arg name="x" value="$(arg x)"/>
        <arg name="y" value="$(arg y)"/>
        <arg name="z" value="$(arg z)"/>
        <arg name="gui" value="$(arg gui)"/>
        <arg name="interactive" value="$(arg interactive)"/>
        <arg name="verbose" value="$(arg verbose)"/>
        <arg name="world" value="$(arg world)"/>
    </include>

    <node name="aruco_det" pkg="px4" type="$(arg detector_type)" output="screen">
        <param name="dictionary_id" value="$(arg dictionary_id)"/>
        <param name="aruco_id" value="$(arg aruco_id)"/>
        <param name="aruco_length" value="$(arg aruco_length)"/>
        <param name="camera_param_path" value="$(find px4)/config/camera_monocular_1280x720.yaml"/>
        <param name="sub_image_topic" value="$(arg sub_image_topic)"/>
        <rosparam command="load" file="$(arg marker_config_path)"/>
    </node>

    <node name="aruco_search_and_detect" pkg="px4" type="$(arg controller_type)" output="screen">
        <param name="auto_arm_offboard" value="$(arg auto_arm_offboard)"/>
        <param name="land_after_detect" value="true"/>
        <param name="takeoff_altitude" value="$(arg takeoff_altitude)"/>
        <param name="search_spacing" value="$(arg search_spacing)"/>
        <param name="search_radius" value="$(arg search_radius)"/>
        <param name="land_descent_rate" value="$(arg land_descent_rate)"/>
        <param name="landing_commit_altitude" value="$(arg landing_commit_altitude)"/>
        <param name="auto_land_settle_time" value="$(arg auto_land_settle_time)"/>
        <param name="marker_estimate_window" value="$(arg marker_estimate_window)"/>
        <param name="marker_estimate_alpha" value="$(arg marker_estimate_alpha)"/>
        <param name="track_pid_kp" value="$(arg track_pid_kp)"/>
        <param name="track_pid_ki" value="$(arg track_pid_ki)"/>
        <param name="track_pid_kd" value="$(arg track_pid_kd)"/>
        <param name="land_pid_kp" value="$(arg land_pid_kp)"/>
        <param name="land_pid_ki" value="$(arg land_pid_ki)"/>
        <param name="land_pid_kd" value="$(arg land_pid_kd)"/>
        <param name="land_z_pid_kp" value="$(arg land_z_pid_kp)"/>
        <param name="land_z_pid_ki" value="$(arg land_z_pid_ki)"/>
        <param name="land_z_pid_kd" value="$(arg land_z_pid_kd)"/>
        <param name="success_result_path" value="$(arg success_result_path)"/>
    </node>
</launch>
